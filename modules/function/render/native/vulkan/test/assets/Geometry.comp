#version 450
layout(local_size_x=1, local_size_y=1, local_size_z=1) in;
layout(set=3, binding=1, std430) writeonly buffer Vertices { vec4 position[3]; } vertices;
layout(set=3, binding=2, std430) writeonly buffer Indices { uint index[3]; } indices;
layout(set=3, binding=3, std430) writeonly buffer Commands
{
    uint count;
    uint instances;
    uint first;
    int base;
    uint first_instance;
} commands;
void main()
{
    vertices.position[0] = vec4(-1, -1, 0.5, 0.25);
    vertices.position[1] = vec4(3, -1, 0.5, 0.25);
    vertices.position[2] = vec4(-1, 3, 0.5, 0.25);
    indices.index[0] = 2;
    indices.index[1] = 0;
    indices.index[2] = 1;
    commands.count = 3;
    commands.instances = 1;
    commands.first = 0;
    commands.base = 0;
    commands.first_instance = 0;
}
