#version 450
#extension GL_GOOGLE_include_directive : require
//! lux-shader stage=vertex entry=main
//! lux-pass-declarations
#include "Parameters.shared.lglslh"
void main()
{
    const vec2 positions[3] = vec2[](vec2(-1, -1), vec2(3, -1), vec2(-1, 3));
    gl_Position = vec4(positions[gl_VertexIndex], 0, 1);
    gl_Position.x += parameters.gain.x - 0.5 + sharedColor().x - 0.5;
}
