    void writeString(std::ostream& output, std::string_view value)
    {
        output.put('"');
        for (const unsigned char character : value)
        {
            switch (character)
            {
            case '"': output << "\\\""; break;
            case '\\': output << "\\\\"; break;
            case '\b': output << "\\b"; break;
            case '\f': output << "\\f"; break;
            case '\n': output << "\\n"; break;
            case '\r': output << "\\r"; break;
            case '\t': output << "\\t"; break;
            default:
                if (character < 0x20U)
                {
                    static constexpr char Hex[] = "0123456789abcdef";
                    output << "\\u00" << Hex[character >> 4U] << Hex[character & 0x0FU];
                }
                else
                {
                    output.put(static_cast<char>(character));
                }
                break;
            }
        }
        output.put('"');
    }

    void writeValue(std::ostream& output, const lux::script::ScriptAbilityValueDescription& value)
    {
        output << "{\"canonical_name\":";
        writeString(output, value.canonical_name);
        output << ",\"type_id\":" << value.type_id
               << ",\"pass\":" << static_cast<unsigned>(value.pass)
               << ",\"abi_kind\":" << static_cast<unsigned>(value.abi_kind)
               << ",\"size\":" << value.size
               << ",\"alignment\":" << value.alignment
               << ",\"lifetime\":" << static_cast<unsigned>(value.lifetime) << '}';
    }

    void writeDescription(std::ostream& output, const lux::script::ScriptAbilityDescription& description)
    {
        output << "{\"contract\":";
        writeString(output, description.id.name());
        output << ",\"contract_id\":" << description.id.hash() << ",\"name\":";
        writeString(output, description.name);
        output << ",\"display_name\":";
        writeString(output, description.display_name);
        output << ",\"schema_version\":" << description.schema_version
               << ",\"schema_hash\":" << description.schema_hash
               << ",\"receiver\":" << static_cast<unsigned>(description.receiver)
               << ",\"methods\":[";
        for (std::size_t method_index{}; method_index < description.methods.size(); ++method_index)
        {
            if (method_index != 0U)
                output.put(',');
            const auto& method = description.methods[method_index];
            output << "{\"method\":";
            writeString(output, method.id.name());
            output << ",\"method_id\":" << method.id.hash() << ",\"name\":";
            writeString(output, method.name);
            output << ",\"display_name\":";
            writeString(output, method.display_name);
            output << ",\"kind\":" << static_cast<unsigned>(method.kind) << ",\"parameters\":[";
            for (std::size_t parameter_index{}; parameter_index < method.parameters.size(); ++parameter_index)
            {
                if (parameter_index != 0U)
                    output.put(',');
                const auto& parameter = method.parameters[parameter_index];
                output << "{\"name\":";
                writeString(output, parameter.name);
                output << ",\"value\":";
                writeValue(output, parameter.value);
                output.put('}');
            }
            output << "],\"results\":[";
            for (std::size_t result_index{}; result_index < method.results.size(); ++result_index)
            {
                if (result_index != 0U)
                    output.put(',');
                writeValue(output, method.results[result_index]);
            }
            output << "]}";
        }
        output << "]}";
    }

