//! lux-shader stage=fragment entry=main
#version 450
#extension GL_EXT_nonuniform_qualifier : require

// =============================================================================
// Skybox fragment shader — 6-face cubemap sampling via bindless array.
//
// Uses the bindless cubemap array (set 2, binding 1) with a push constant
// index, matching the engine's GeneralDescriptorSetLayout convention.
// =============================================================================

layout(location = 0) in vec3 vWorldDir;
layout(location = 0) out vec4 outColor;

uniform samplerCube uCubeTex[];

#include "view_pc_prefix.glsl"
layout(push_constant) uniform PC {
    LUX_VIEW_PC_PREFIX      // uint scene_index (0); uint view_index (4)
    uint skybox_index;   // Bindless index into uCubeTex[]
    float rotation_radians;
    float intensity;
} uPC;

void main()
{
    vec3 dir = normalize(vWorldDir);
    float cosine = cos(uPC.rotation_radians);
    float sine = sin(uPC.rotation_radians);
    dir.xz = mat2(cosine, -sine, sine, cosine) * dir.xz;
    outColor = texture(
        uCubeTex[nonuniformEXT(uPC.skybox_index)], dir) * uPC.intensity;
}
