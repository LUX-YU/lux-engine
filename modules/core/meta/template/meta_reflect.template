// Component registry catalogue lives in the ECS layer, not in `core::meta`.
#include <lux/engine/ecs/ComponentTypeCatalog.hpp>
#include <lux/engine/ecs/RegistryStorageCapacity.hpp>

// ── Component-catalogue accessor shims ────────────────────────────────────────
// Function templates so each `if constexpr` branch is DISCARDED UNCHECKED — a
// plain (non-generic) lambda body is fully semantic-checked even behind a
// false `if constexpr`, which breaks on:
//   • empty types (tag components): entt's empty-type optimisation stores no
//     instance — try_get / emplace_or_replace / patch are void or ill-formed
//     there. A tag's get() hands back a shared static probe: non-null still
//     means "present", and the reflection walker reads zero fields through it.
//   • move-only types: the copy-clone branch would fail to compile. Their
//     clone now exists but is a no-op returning null — RegistrySnapshot and
//     Duplicate treat that exactly like the null clone POINTER they used to
//     see (both skip silently on a null).
namespace
{
    template <class C>
    void* lux_meta_component_get(
        lux::meta::EntityRegistryBase& r,
        entt::entity e)
    {
        if constexpr (std::is_empty_v<C>)
        {
            static C probe{};
            return r.all_of<C>(e) ? &probe : nullptr;
        }
        else
            return r.try_get<C>(e);
    }

    template <class C>
    void* lux_meta_component_emplace(
        lux::meta::EntityRegistryBase& r,
        entt::entity e)
    {
        if constexpr (std::is_empty_v<C>)
        {
            r.emplace_or_replace<C>(e);
            static C probe{};
            return &probe;
        }
        else
            return &r.emplace_or_replace<C>(e);
    }

    template <class C>
    void lux_meta_component_notify(
        lux::meta::EntityRegistryBase& r,
        entt::entity e)
    {
        // Empty type: no fields to poke and registry::patch is ill-formed for
        // it — the write contract has nothing to observe. No-op.
        if constexpr (!std::is_empty_v<C>)
        {
            if (r.all_of<C>(e))
                r.patch<C>(e);
        }
    }

    template <class C>
    void* lux_meta_component_clone(
        lux::meta::EntityRegistryBase& sr,
        entt::entity src,
        lux::meta::EntityRegistryBase& dr,
        entt::entity dst)
    {
        if constexpr (std::is_empty_v<C>)
        {
            // Presence IS the value: clone copies the tag bit. Without this,
            // RegistrySnapshot would drop tags across an Edit/Play restore.
            if (!sr.all_of<C>(src))
                return nullptr;
            dr.emplace_or_replace<C>(dst);
            static C probe{};
            return &probe;
        }
        else if constexpr (std::is_copy_constructible_v<C>)
        {
            const auto* s = sr.try_get<C>(src);
            return s ? &dr.emplace_or_replace<C>(dst, *s) : nullptr;
        }
        else
            return nullptr;   // move-only: silent skip, like the old null clone
    }

    template <class C>
    void lux_meta_component_reserve(
        lux::meta::EntityRegistryBase& r,
        std::size_t additional)
    {
        auto& storage = r.storage<C>();
        // The current operation ABI has no error return. Decoded entity
        // counts are bounded before this adapter is called, so overflow here
        // is an engine invariant. This still reserves only EnTT packed/payload
        // capacity; it is not a sparse-page or allocator reservation.
        if (!lux::ecs::reserveAdditionalStorageCapacity(
                storage, additional))
        {
            std::abort();
        }
    }

    template <class C>
    void* lux_meta_component_transfer(
        lux::meta::EntityRegistryBase& sr,
        entt::entity src,
        lux::meta::EntityRegistryBase& dr,
        entt::entity dst) noexcept
    {
        if constexpr (std::is_empty_v<C>)
        {
            if (!sr.all_of<C>(src))
                return nullptr;
            dr.emplace_or_replace<C>(dst);
            sr.remove<C>(src);
            static C probe{};
            return &probe;
        }
        else if constexpr (std::is_nothrow_move_constructible_v<C>)
        {
            auto* source = sr.try_get<C>(src);
            if (!source)
                return nullptr;
            auto* result = &dr.emplace_or_replace<C>(dst, std::move(*source));
            sr.remove<C>(src);
            return result;
        }
        else
            return nullptr;
    }
} // namespace
