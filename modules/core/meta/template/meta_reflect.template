        lux::meta::RefParam& rp = inv.parameters.back();
        rp.name = "{{ p.name }}";
        using param_type_{{ loop.index }} = {{ pty.id }};

        static constexpr auto qt = lux::meta::__builtin_qual_type<param_type_{{ loop.index }}>;
        static constexpr auto is_reflected_record =
            lux_meta_generated_record_v<param_type_{{ loop.index }}>;
        static constexpr auto is_reflected_value =
            lux::meta::is_reflected_value_v<
                lux::meta::remove_one_modifier_t<param_type_{{ loop.index }}>>;
        static_assert(static_cast<lux::meta::EBaseType>(qt.base) != lux::meta::EBaseType::Unknown, "Unsupported param type in {{ fn.spelling }}");
        rp.type = lux::meta::ref_type_of_v<{{pty.id}}>;
        if constexpr(is_reflected_record || is_reflected_value){
            fix_list.push_back({lux::cxx::type_name<lux::meta::remove_one_modifier_t<{{ pty.id }}>>(),&rp.type});
        }
        rp.is_out = false;  /* TODO: mark out‑params */
    }
    {% endfor %}

    /* invoker -------------------------------------------------------------- */
    inv.invoker = [](void*, void** args, void* rst)
    {
        using ret_type = {{ fn.result_type_id }};
        {% for param_id in fn.params -%}{%- set p = decl_from_id(param_id) -%}{%- set pty = type_from_id(p.type_id) %}
