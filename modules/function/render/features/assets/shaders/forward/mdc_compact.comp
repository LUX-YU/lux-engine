#version 450
// =========================================================================
//  mdc_compact.comp
//
//  Trivial per-MDC compact pass: reads per-MDC visible counts from the cull
//  phase and writes one VkDrawIndexedIndirectCommand per MDC.
//
//  Replaces finalize_indirect.comp for the view path.
//
//  Descriptor contract (shared 8-binding cull layout):
//    binding 2: draw-count buffer  (per-MDC atomic counts, READ)
//    binding 3: indirect buffer    (output IndirectCmd per MDC, WRITE)
//    binding 4: mesh-section table (MeshSectionRecord[], READ)
//    binding 7: MDC info buffer    (interleaved {offset, section_id}, READ)
//
//  Dispatch: ceil(mdc_count / 64) workgroups in x.
// =========================================================================

layout(local_size_x = 64) in;

#include "instance.glsl"

layout(push_constant) uniform PC {
    uint mdc_count;
} pc;

layout(set = 0, binding = 2, std430) buffer DrawCountBuf {
    uint draw_counts[];
} uDrawCounts;


layout(set = 0, binding = 3, std430) writeonly buffer IndirectBuf {
    IndirectCmd commands[];
} uIndirect;

layout(set = 0, binding = 4, std430) readonly buffer MeshSectionBuf {
    MeshSectionRecord sections[];
} uSections;

layout(set = 0, binding = 7, std430) readonly buffer MdcInfoBuf {
    uint data[];   // interleaved {offset, section_id} + sentinel
} uMdcInfo;

void main()
{
    uint mdc = gl_GlobalInvocationID.x;
    if (mdc >= pc.mdc_count)
        return;

    uint mdc_offset    = uMdcInfo.data[mdc * 2u];
    uint mdc_capacity  = uMdcInfo.data[(mdc + 1u) * 2u] - mdc_offset;
    // Cull workgroups reserve one contiguous range per MDC.  Their global
    // atomicAdd may legitimately count past a full MDC; only the in-capacity
    // prefix is written, so compact clamps the draw to the same prefix.
    uint visible_count = min(uDrawCounts.draw_counts[mdc], mdc_capacity);
    uint section_id    = uMdcInfo.data[mdc * 2u + 1u];

    if (visible_count == 0u || section_id == 0xFFFFFFFFu)
    {
        // Write a zero-instance draw (GPU no-op)
        uIndirect.commands[mdc].indexCount    = 0u;
        uIndirect.commands[mdc].instanceCount = 0u;
        uIndirect.commands[mdc].firstIndex    = 0u;
        uIndirect.commands[mdc].vertexOffset  = 0;
        uIndirect.commands[mdc].firstInstance = 0u;
        uDrawCounts.draw_counts[mdc] = 0u;
        return;
    }

    MeshSectionRecord section = uSections.sections[section_id];

    uIndirect.commands[mdc].indexCount    = section.index_count;
    uIndirect.commands[mdc].instanceCount = visible_count;
    uIndirect.commands[mdc].firstIndex    = section.first_index;
    uIndirect.commands[mdc].vertexOffset  = section.base_vertex;
    uIndirect.commands[mdc].firstInstance = mdc_offset;

    // Overwrite count with 1 so DrawIndexedIndirectCount sees exactly one
    // valid command for this MDC slot.  (Required when the draw phase uses
    // per-MDC DrawIndexedIndirectCount with maxDraw=1.)
    uDrawCounts.draw_counts[mdc] = 1u;
}
