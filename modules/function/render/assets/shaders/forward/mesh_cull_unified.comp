#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// =========================================================================
//  mesh_cull_unified.comp
//
//  Unified mesh culling kernel for view and shadow modes.
//  Shared 8-binding cull descriptor layout:
//    binding 0: frustum plane UBO (view uses first 6 planes; shadow uses 6*slice)
//    binding 1: InstanceCullMeta[]
//    binding 2: draw-count buffer
//    binding 3: indirect buffer
//    binding 4: mesh-section table
//    binding 5: instance properties
//    binding 6: visible-instance payload buffer
//    binding 7: MDC info buffer (view mode only: per-MDC offset+section pairs)
// =========================================================================

layout(local_size_x = 64) in;

#include "instance.glsl"

layout(constant_id = 0) const uint CULL_MODE = 0u;           // 0: view, 1: shadow
layout(constant_id = 2) const uint DEFAULT_GEOMETRY_KIND_COUNT = 5u;
layout(constant_id = 102) const uint HZB_MODE = 0u;          // Reserved for M4 D(HZB)

const uint CULL_MODE_VIEW = 0u;
const uint CULL_MODE_SHADOW = 1u;
const float kDirectionalCascadeCullSlack = 6.0;

// World-partition per-slot active mask, addressed by buffer-device-address carried in
// the push-constant — replaces the old fixed descriptor binding 8. active_mask[gid]==0
// means the instance's cell is dormant (outside streaming range). addr==0 in the PC
// means large-world is disabled → no mask, every instance active.
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer ActiveMaskRef {
    uint active_mask[];
};

layout(push_constant) uniform PC {
    uint slot_count;
    uint max_draws_per_bucket;
    uint required_pass_mask;
    uint required_geometry_kind;
    uint geometry_kind_count_or_slice_count;
    uint buckets_per_geometry_or_unused;
    uint enabled_geometry_mask;
    uint extension_flags;
    uint reserved_input0;
    uint reserved_input1;
    uint64_t active_mask_addr;   // BDA of the world-partition active mask; 0 = none
} pc;

layout(set = 0, binding = 0, std430) readonly buffer CullPlanesBuf {
    vec4  planes[];   // 6 planes per shadow slice, followed by slice_groups
} uCull;

layout(set = 0, binding = 1, std430) readonly buffer CullMetaBuf {
    InstanceCullMeta metas[];
} uCullMeta;

layout(set = 0, binding = 2, std430) buffer DrawCountBuf {
    uint draw_counts[];
} uDrawCounts;

struct IndirectCmd {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};
layout(set = 0, binding = 3, std430) writeonly buffer IndirectBuf {
    IndirectCmd commands[];
} uIndirect;

layout(set = 0, binding = 4, std430) readonly buffer MeshSectionBuf {
    MeshSectionRecord sections[];
} uSections;

layout(set = 0, binding = 5, std430) readonly buffer PropertyBuf {
    InstanceProperty props[];
} uProps;

layout(set = 0, binding = 6, std430) writeonly buffer VisibleBuf {
    uint ids[];
} uVisible;

// Per-MDC info: interleaved {uint offset, uint section_id} + sentinel.
// MDC i has visible_offset = uMdcInfo.data[i*2], section_id = uMdcInfo.data[i*2+1].
// Capacity = uMdcInfo.data[(i+1)*2] - uMdcInfo.data[i*2].
layout(set = 0, binding = 7, std430) readonly buffer MdcInfoBuf {
    uint data[];
} uMdcInfo;

bool frustumCull(uint slice_index, vec3 center, float radius)
{
    uint base = slice_index * 6u;
    for (uint i = 0u; i < 6u; ++i)
    {
        vec4 p = uCull.planes[base + i];
        if (dot(p.xyz, center) + p.w < -radius)
            return false;
    }
    return true;
}

// Angular-size (radius/depth) thresholds: below kLodCoverage[i] drop to LOD i+1
// (coarser = farther/smaller on screen). Global for now; per-mesh override later.
const float kLodCoverage[3] = float[3](0.10, 0.035, 0.012);

// Pick a discrete LOD for the bounding sphere from its on-screen coverage. View-
// space depth ≈ signed distance to the near plane (Frustum::Near index 4; its
// inward normal points down the view direction), so radius/depth is the angular
// radius — resolution-independent and monotonic with camera distance.
uint pickLod(vec3 center, float radius, uint lod_count)
{
    if (lod_count <= 1u) return 0u;
    vec4  nearp = uCull.planes[4];
    float depth = dot(nearp.xyz, center) + nearp.w;
    float coverage = radius / max(depth, 1e-3);
    uint  lod = 0u;
    for (uint i = 0u; i + 1u < lod_count && i < 3u; ++i)
    {
        if (coverage < kLodCoverage[i]) lod = i + 1u;
        else break;
    }
    return lod;
}

// ── HZB occlusion (Stage C) — compiled ONLY into the `hzb` build variant ──
// set 1 = combined sampler over the PREVIOUS frame's max-Z pyramid + that
// frame's view params. Wrapped in HZB_ENABLED so the `no_hzb` variant does NOT
// declare set 1 at all. A spec-constant fold does NOT remove a statically-used
// resource from the SPIR-V — Vulkan VUID-07988 still sees the OpLoad — so the
// set-0-only cull pipelines (shadow / HZB-off view) must come from a variant
// that never declares set 1. The HZB on/off split is therefore a build-time
// shader variant (no_hzb / hzb), mirroring the PCF/EVSM shadow technique split.
#ifdef HZB_ENABLED
layout(set = 1, binding = 0) uniform sampler2D uHzb;
layout(set = 1, binding = 1, std140) uniform HzbViewBuf {
    mat4 view_proj;   // last frame's view*proj (HZB is last frame's depth)
    vec4 params;      // (hzb_width, hzb_height, mip_count, _pad)
} uHzbView;

// Conservative max-Z occlusion test. Forward-Z (near=0/far=1): the pyramid
// stores the FARTHEST visible depth, so a sphere is occluded only when its
// NEAREST point is still behind the tile's max depth. Any degeneracy (crosses
// the near plane, projection blows up) returns false = NOT occluded — never
// over-cull (only ever miss a cull).
bool hzbOccluded(vec3 c, float r)
{
    if (uHzbView.params.z < 1.0) return false;  // HZB just (re)built / not ready → keep
    vec3 ndc_min = vec3( 1e30);
    vec3 ndc_max = vec3(-1e30);
    for (int i = 0; i < 8; ++i)
    {
        vec3 corner = c + r * vec3((i & 1) != 0 ? 1.0 : -1.0,
                                   (i & 2) != 0 ? 1.0 : -1.0,
                                   (i & 4) != 0 ? 1.0 : -1.0);
        vec4 clip = uHzbView.view_proj * vec4(corner, 1.0);
        if (clip.w <= 0.0) return false;            // crosses near plane → keep
        vec3 ndc = clip.xyz / clip.w;
        ndc_min = min(ndc_min, ndc);
        ndc_max = max(ndc_max, ndc);
    }
    // y-flip is baked into proj → uv = ndc*0.5+0.5, do NOT flip Y again.
    vec2 uv_min = clamp(ndc_min.xy * 0.5 + 0.5, 0.0, 1.0);
    vec2 uv_max = clamp(ndc_max.xy * 0.5 + 0.5, 0.0, 1.0);
    vec2  px  = (uv_max - uv_min) * uHzbView.params.xy;       // AABB in HZB texels
    float mip = clamp(ceil(log2(max(max(px.x, px.y), 1.0))),
                      0.0, uHzbView.params.z - 1.0);
    vec2  uv_c     = (uv_min + uv_max) * 0.5;
    float tileMaxZ = textureLod(uHzb, uv_c, mip).r;           // farthest in that tile
    float sphereMinZ = ndc_min.z;                             // nearest point's NDC depth
    return sphereMinZ > tileMaxZ;                             // fully behind → occluded
}
#endif // HZB_ENABLED

uint shadowGroupIndex(uint slice_index, uint slice_count)
{
    // Slice-group map starts right after the planes region (6 vec4 per slice).
    uint group_base = slice_count * 6u;
    uint word = group_base + slice_index;
    return floatBitsToUint(uCull.planes[word].x);
}

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.slot_count)
        return;

    // W1 world-partition coarse cull: dormant-cell instances early-out here, before any
    // frustum / HZB / atomic-append work (a dormant instance pays only one mask read).
    // active_mask_addr==0 → large-world disabled (no mask bound) → skip, treat as active.
    if (pc.active_mask_addr != 0ul)
    {
        if (ActiveMaskRef(pc.active_mask_addr).active_mask[gid] == 0u)
            return;
    }

    InstanceCullMeta meta = uCullMeta.metas[gid];
    if (meta.bsphere.w < 0.0)
        return;
    if (meta.lod_count == 0u)
        return;

    InstanceProperty prop = uProps.props[gid];
    if ((prop.flags & 0x4u) == 0u)
        return;

    uint pass_mask = prop.pass_and_geometry & 0xFFFFu;
    if ((pass_mask & pc.required_pass_mask) == 0u)
        return;

    uint geometry_kind = (prop.pass_and_geometry >> 16u) & 0xFFu;
    // The union push-constant field carries the geometry-kind count ONLY in view
    // mode; in shadow mode it carries slice_count (read as such at line ~157).
    // Using it as the kind bound in shadow mode silently culls every instance
    // whose kind >= slice_count — e.g. with the default 1-slice directional CSM,
    // SkinnedMesh (kind=1), Particle, Decal stop casting shadows. So in shadow
    // mode always use the true kind count.
    uint geometry_kind_count = (CULL_MODE == CULL_MODE_VIEW)
        ? pc.geometry_kind_count_or_slice_count
        : DEFAULT_GEOMETRY_KIND_COUNT;
    if (geometry_kind_count == 0u)
        geometry_kind_count = DEFAULT_GEOMETRY_KIND_COUNT;
    if (geometry_kind >= geometry_kind_count)
        return;
    if (pc.required_geometry_kind != 0xFFFFFFFFu && geometry_kind != pc.required_geometry_kind)
        return;
    if (((pc.enabled_geometry_mask >> geometry_kind) & 1u) == 0u)
        return;

    if (CULL_MODE == CULL_MODE_VIEW)
    {
        if (!frustumCull(0u, meta.bsphere.xyz, meta.bsphere.w))
            return;

#ifdef HZB_ENABLED
        // HZB occlusion: drop instances fully behind last frame's depth.
        if (HZB_MODE == 1u && hzbOccluded(meta.bsphere.xyz, meta.bsphere.w))
            return;
#endif

        // ── Per-MDC atomic append (used with mdc_compact pass) ──
        uint lod = pickLod(meta.bsphere.xyz, meta.bsphere.w, meta.lod_count);
        uint mdc = meta.lod_mdc[lod];
        uint mdc_offset   = uMdcInfo.data[mdc * 2u];
        uint mdc_capacity = uMdcInfo.data[(mdc + 1u) * 2u] - mdc_offset;
        uint slot = atomicAdd(uDrawCounts.draw_counts[mdc], 1u);
        if (slot >= mdc_capacity)
        {
            atomicAdd(uDrawCounts.draw_counts[mdc], uint(-1));
            return;
        }
        uVisible.ids[mdc_offset + slot] = gid;
        return;
    }

    if ((prop.flags & 0x1u) == 0u)
        return;

    uint slice_count = pc.geometry_kind_count_or_slice_count;
    uint view_mdc_count = pc.reserved_input0;
    for (uint s = 0u; s < slice_count; ++s)
    {
        float cull_radius = meta.bsphere.w;
        if (s < 4u)
            cull_radius += kDirectionalCascadeCullSlack;
        if (!frustumCull(s, meta.bsphere.xyz, cull_radius))
            continue;

        uint group = shadowGroupIndex(s, slice_count);
        uint bias_group_count = pc.buckets_per_geometry_or_unused;
        if (group >= bias_group_count)
            continue;

        // ── Per-MDC atomic append (shadow MDC mode) ──
        // Shadows always cast from LOD0 (highest detail) for crisp silhouettes.
        uint shadow_mdc = group * view_mdc_count + meta.lod_mdc[0];
        uint mdc_offset   = uMdcInfo.data[shadow_mdc * 2u];
        uint mdc_capacity = uMdcInfo.data[(shadow_mdc + 1u) * 2u] - mdc_offset;
        uint slot = atomicAdd(uDrawCounts.draw_counts[shadow_mdc], 1u);
        if (slot >= mdc_capacity)
        {
            atomicAdd(uDrawCounts.draw_counts[shadow_mdc], uint(-1));
            continue;
        }
        uVisible.ids[mdc_offset + slot] = (s << 20u) | gid;
    }
}
