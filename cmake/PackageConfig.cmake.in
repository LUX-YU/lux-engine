@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/@PACKAGE_PROJECT_NAME@-available-components.cmake")
foreach(_component IN LISTS @PACKAGE_PROJECT_NAME@_FIND_COMPONENTS)
    if(NOT _component IN_LIST @PACKAGE_PROJECT_NAME@_AVAILABLE_COMPONENTS)
        set(@PACKAGE_PROJECT_NAME@_FOUND FALSE)
        set(@PACKAGE_PROJECT_NAME@_NOT_FOUND_MESSAGE "Component '${_component}' is not available")
        return()
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/${_component}/@PACKAGE_PROJECT_NAME@-${_component}-import.cmake")
endforeach()
