#version 450
// ClusterBuild: clear per-cluster counters and overflow state.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std140) uniform ClusterParamsUBO {
    mat4 view;
    mat4 proj;
    vec4 viewport;
    uvec4 grid;
    uvec4 limits;
} uParams;

layout(set = 0, binding = 1, std430) buffer ClusterCountBuf {
    uint counts[];
} uCounts;

layout(set = 0, binding = 3, std430) buffer ClusterWriteHeadBuf {
    uint heads[];
} uHeads;

layout(set = 0, binding = 5, std430) buffer ClusterOverflowBuf {
    uint overflow;
} uOverflow;

void main()
{
    uint cluster_count = max(uParams.limits.x, 1u);
    uint idx = gl_GlobalInvocationID.x;
    if (idx < cluster_count)
    {
        uCounts.counts[idx] = 0u;
        uHeads.heads[idx] = 0u;
    }
    if (idx == 0u)
    {
        uOverflow.overflow = 0u;
    }
}
