#version 460
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform usampler2D images[];
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer InputData
{
    uint values[];
};
layout(buffer_reference, std430, buffer_reference_align = 16) writeonly buffer OutputData
{
    uvec4 values[];
};
layout(push_constant) uniform Parameters
{
    InputData input_data;
    OutputData output_data;
    uint image_index;
} parameters;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    parameters.output_data.values[index] = texelFetch(images[nonuniformEXT(parameters.image_index)], ivec2(0), 0)
        + uvec4(parameters.input_data.values[index]);
}
