+    public:
+        PartialWindow(object::ObjectDispatcherRef dispatcher, int& live)
+            : Pane(dispatcher, ui::PaneId{"partial-constructor"}, ui::PaneTypeId{"test"}, "partial"),
+              first_(*this, live, false), rejected_(*this, live, true)
+        {}
