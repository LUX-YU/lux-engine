//! lux-shader stage=fragment entry=main
#version 450
#extension GL_EXT_nonuniform_qualifier : require
// =========================================================================
//  fr_stylized.frag — Forward fragment shader for Stylized family (Family 3)
//
//  Matches StylizedFamilyGPU (C++ side).
//  Toon / cel-shading with quantised diffuse and specular bands.
//  Optional ramp texture lookup (HAS_RAMP_MAP) replaces step function.
//
//  Specialization constants:
//    0  = HAS_NORMAL_MAP
//    2  = HAS_EMISSION
//    13 = HAS_RAMP_MAP
// =========================================================================
#include "lighting_common.glsl"
#define SHADOW_ENABLED
// Shadow technique selected at SPIR-V variant build time via
// LUX_SHADOW_TECHNIQUE_ID (PCF=0, EVSM=1, future MSM=2, VSM=3 ...).
// glslc doesn't macro-expand the token after `#include`, hence the integer
// switch instead of indirecting the path string.
#ifndef LUX_SHADOW_TECHNIQUE_ID
#define LUX_SHADOW_TECHNIQUE_ID 0
#endif
#if LUX_SHADOW_TECHNIQUE_ID == 0
#include "shadow_pcf.glsl"
#elif LUX_SHADOW_TECHNIQUE_ID == 1
#include "shadow_evsm.glsl"
#else
#error "Unknown LUX_SHADOW_TECHNIQUE_ID"
#endif
#include "brdf/brdf_common.glsl"
#include "brdf/brdf_toon.glsl"
#include "brdf/brdf_oren_nayar.glsl"

// ========== Specialization Constants ==========
layout(constant_id = 0)  const bool HAS_NORMAL_MAP = true;
layout(constant_id = 2)  const bool HAS_EMISSION   = false;
layout(constant_id = 13) const bool HAS_RAMP_MAP   = false;

// ========== SET 4: Stylized Family Material (binding 3) ==========
layout(std430) readonly buffer StylizedBuf {
    StylizedMaterialGPU mats[];
} uStylized;

// =========================================================================
//  Main
// =========================================================================
void main()
{
    luxApplyDirectedTransitionCoverage(
        vTransitionCoverage, vTransitionSeed, vTransitionFadeOut != 0u);
    uint matIdx = vMatIndex;
    StylizedMaterialGPU m = uStylized.mats[matIdx];

    // --- Base colour ---
    vec3 baseColor = m.base_color.xyz * vInstanceTint.rgb;
    if (hasBit(m.tex_mask, 0u))
        baseColor *= luxSampleTexture(m.tex[0], vUV).rgb;

    // --- Normal ---
    vec3 N = vWorldNormal;
    if (HAS_NORMAL_MAP && hasBit(m.tex_mask, 2u))
        N = calculateWorldNormal(vWorldNormal, vWorldTangent, vWorldBitangent, vUV, m.tex[2]);
    N = normalize(N);
    // Two-sided lighting: flip the normal for back faces (only reached by
    // double_sided materials, cull disabled). No-op for single-sided
    // (gl_FrontFacing always true). Mirrors fr_pbr.
    if (!gl_FrontFacing)
        N = -N;

    vec3  V = normalize(vViewDir);
    float view_depth = computeViewDepth(vWorldPos);

    float diffuse_steps  = m.toon_params.x;
    float specular_steps = m.toon_params.y;
    float sigma_deg      = m.toon_params.w;   // -1 if no Oren-Nayar
    bool  use_ramp       = HAS_RAMP_MAP && hasBit(m.tex_mask, 1u);

    // --- Lighting ---
    vec3 Lo = vec3(0.0);

    // ---- Directional lights ----
    for (int i = 0; i < uDirectionalLights.lights.length(); ++i) {
        vec3 Ldir = uDirectionalLights.lights[i].direction;
        if (dot(Ldir, Ldir) < 1e-8) continue;
        vec3 L = normalize(-Ldir);
        float NdotL = max(dot(N, L), 0.0);
        vec3 lc = uDirectionalLights.lights[i].color * uDirectionalLights.lights[i].intensity;
        float shadow = directionalShadow(uint(i), vWorldPos, N, view_depth);

        // Diffuse: optional Oren-Nayar roughening before toon quantisation
        float diff_raw = NdotL;
        if (sigma_deg >= 0.0)
            diff_raw = orenNayarDiffuse(L, V, N, radians(sigma_deg));

        float diff_t;
        if (use_ramp)
            diff_t = luxSampleTexture(m.tex[1], vec2(diff_raw, 0.5)).r;
        else
            diff_t = toonStep(diff_raw, diffuse_steps);

        Lo += baseColor * lc * diff_t * shadow;

        // Specular band
        if (specular_steps > 0.0) {
            vec3  H    = normalize(L + V);
            float spec = pow(max(dot(N, H), 0.0), 32.0);
            Lo += lc * toonStep(spec, specular_steps) * shadow;
        }
    }

    // ---- Point lights ----
    for (int i = 0; i < uPointLights.lights.length(); ++i) {
        if (uPointLights.lights[i].range <= 0.0) continue;
        vec3  lv = luxPointLightViewPosition(uint(i)) - vWorldPos;
        float d  = length(lv);
        if (d > uPointLights.lights[i].range) continue;
        vec3  L = lv / d;
        float NdotL = max(dot(N, L), 0.0);
        float att = 1.0 / (uPointLights.lights[i].attenuation_constant +
                           uPointLights.lights[i].attenuation_linear * d +
                           uPointLights.lights[i].attenuation_quadratic * d * d);
        vec3 lc = uPointLights.lights[i].color * uPointLights.lights[i].intensity * att;

        float pshadow = 1.0;
        if ((uPointLights.lights[i].flags & 1u) != 0u)
            pshadow = pointShadow(uint(i), vWorldPos, N);

        float diff_raw = NdotL;
        if (sigma_deg >= 0.0)
            diff_raw = orenNayarDiffuse(L, V, N, radians(sigma_deg));

        float diff_t;
        if (use_ramp)
            diff_t = luxSampleTexture(m.tex[1], vec2(diff_raw, 0.5)).r;
        else
            diff_t = toonStep(diff_raw, diffuse_steps);

        Lo += baseColor * lc * diff_t * pshadow;

        if (specular_steps > 0.0) {
            vec3  H    = normalize(L + V);
            float spec = pow(max(dot(N, H), 0.0), 32.0);
            Lo += lc * toonStep(spec, specular_steps) * pshadow;
        }
    }

    // --- Ambient ---
    vec3 ambient = kAmbient * baseColor;

    // --- Emissive ---
    vec3 emissive = m.emissive.xyz * m.emissive.w;
    if (HAS_EMISSION && hasBit(m.tex_mask, 3u))
        emissive *= luxSampleTexture(m.tex[3], vUV).rgb;

    vec3 color = ambient + Lo + emissive;
    outColor = vec4(color, 1.0);
}
