//! lux-shader stage=compute entry=main
layout(local_size_x=1) in;
void main() { float value = p_block.data.x + p_block.data.y + p_block.data.z + p_block.data.w
    + p_values.data[0].gain + p_values.data[0].weights[2] + lux_push.p_settings_0_gain + lux_push.p_settings_1_weights_2;
    imageStore(p_output, ivec2(0), vec4(value)); }
