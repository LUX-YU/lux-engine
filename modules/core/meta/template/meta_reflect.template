static void reflect_{{ rec.hash }}(lux::meta::ReflectionRegistry& registry, lux::meta::qual_type_index_fix_list& fix_list)
{
    auto ret   = std::make_unique<lux::meta::RefClass>();
    auto& cls  = *ret;

    static_assert(std::is_default_constructible_v<{{ rec.fq_name }}>, "Reflected class must have a default ctor");

    cls.name        = "{{ rec.name }}";
    cls.full_name   = "{{ rec.fq_name }}";
    cls.is_abstract = {{ rec.is_abstract }};
    cls.hash        = {{ rec.hash }}ull;
    cls.type        = lux::meta::ref_type_of_v<{{ rec.fq_name }}>;

    fix_list.push_back({"{{ rec.fq_name }}",&cls.type});
    cls.construct   = constructor_{{ rec.hash }};
    cls.destruct    = destructor_{{ rec.hash }};
    cls.construct_symbol = "constructor_{{ rec.hash }}";
    cls.destruct_symbol  = "destructor_{{ rec.hash }}";
    lux::meta::ref_class_func_gen(cls);

    /* class-level annotation -------------------------------------------- */
    {%- set is_component = annotation_has(rec, "component") -%}
    {%- set component_serialization = annotation_get_or(rec, "serialization", "cooked") -%}
    {%- for attr in rec.attributes -%}
        {%- if annotation_has(attr, "luxref::class") %}
    { static constexpr char kClassAnnot_{{ rec.hash }}[] = R"__LUX_ANNOT({{ attr }})__LUX_ANNOT"; cls.annotation_str = kClassAnnot_{{ rec.hash }}; }
        {%- endif -%}
    {%- endfor %}
    
    {% set parent_chain = parent_chain(rec.id, "lux::meta::EntityObject") %}
    {% for parent_info in parent_chain -%}
        cls.parent_chain.push_back({{ parent_info.hash }}ull);
    {% endfor %}

    /* The fix list stores RefType addresses until every class in the module
       has been registered.  Reserve before taking any field address so later
       push_back calls cannot invalidate an earlier nested-type fix-up.  The
       declaration count is a safe upper bound when private/skipped fields are
       filtered below. */
    cls.fields.reserve({{ length(rec.field_decls) }}u);

    /* fields --------------------------------------------------------------- */
    {% for field_id in rec.field_decls -%}{%- set field = decl_from_id(field_id) -%}
    {%- set skip_field = annotation_has(field, "luxref::property::skip") -%}
    {%- if field.visibility == 1 and not skip_field %}
    {
        cls.fields.push_back({});
        lux::meta::RefField& f = cls.fields.back();
        f.name        = "{{ field.name }}";
        f.owner_class = &cls;
        f.visibility  = lux::meta::EVisibility::Public;
        /* offsetof, not the parse-time bit offset ({{ field.offset }} bits on the
           generating host). libclang computes offsets against the HOST ABI, so a
           baked literal is only correct where it was generated — cross-compiling
           to a target whose ABI differs (long is 4 bytes on Windows and 8 on
           Android; MSVC and the Itanium ABI lay out bitfields and empty bases
           differently) would silently write fields to the wrong addresses, with
           no compile-time signal. Letting the TARGET compiler evaluate offsetof
           makes the generated source ABI-neutral, which is also what allows it
           to be generated once and compiled for every platform. */
        f.offset      = offsetof({{ rec.fq_name }}, {{ field.name }});

        using field_type_{{ loop.index }} = decltype({{ field.fq_name }});
        static constexpr auto qt = lux::meta::__builtin_qual_type<field_type_{{ loop.index }}>;
        static constexpr auto is_lux_obj = std::is_base_of_v<lux::meta::EntityObject, field_type_{{ loop.index }}>;
        static constexpr auto is_reflected_value =
            lux::meta::is_reflected_value_v<
                lux::meta::remove_one_modifier_t<field_type_{{ loop.index }}>>;
        static_assert(static_cast<lux::meta::EBaseType>(qt.base) != lux::meta::EBaseType::Unknown, "Unsupported field type {{ field.name }}");

        f.type = lux::meta::ref_type_of_v<{{ field.type_id }}>;
        if constexpr(is_lux_obj || is_reflected_value){
            fix_list.push_back({lux::cxx::type_name<lux::meta::remove_one_modifier_t<{{ field.type_id }}>>(),&f.type});
        }
        f.is_const    = std::is_const_v<std::remove_reference_t<field_type_{{ loop.index }}>>;
        f.is_volatile = std::is_volatile_v<std::remove_reference_t<field_type_{{ loop.index }}>>;{% for attr in field.attributes %}{% if annotation_has(attr, "luxref::property::member") %}
        { static constexpr char kAnnot_{{ rec.hash }}_{{ field.name }}[] = R"__LUX_ANNOT({{ attr }})__LUX_ANNOT"; f.annotation_str = kAnnot_{{ rec.hash }}_{{ field.name }}; }{% endif %}{% endfor %}
    }
    {%- endif %}{%- endfor %}

    /* methods -------------------------------------------------------------- */
    {% for method_id in rec.method_decls -%}{%- set method = decl_from_id(method_id) -%}{% if method.visibility == 1 %}
    {
        cls.methods.push_back({});
        lux::meta::RefMethod& m = cls.methods.back();
        m.owner_class   = &cls;
        m.visibility    = lux::meta::EVisibility::Public;
        m.is_static     = {{ method.is_static }};
        m.is_virtual    = {{ method.is_virtual }};
        m.is_const      = {{ method.is_const }};

        auto& inv       = m.invokable;
        inv.name        = "{{ method.spelling }}";
        inv.full_name   = "{{ method.fq_name }}";
        inv.is_variadic = {{ method.is_variadic }};
        inv.type_signature   = "{{ method.type_id }}";

        /* return ----------------------------------------------------------- */
        using ret_type = {{ method.result_type_id }};
        static constexpr auto qt_ret = lux::meta::__builtin_qual_type<ret_type>;
        static constexpr auto is_lux_obj = std::is_base_of_v<lux::meta::EntityObject, ret_type>;
        static_assert(static_cast<lux::meta::EBaseType>(qt_ret.base) != lux::meta::EBaseType::Unknown, "Unsupported return type for {{ method.spelling }}");

        inv.return_type = lux::meta::ref_type_of_v<ret_type>;
        if constexpr(is_lux_obj){
            fix_list.push_back({lux::cxx::type_name<lux::meta::remove_one_modifier_t<{{ method.result_type_id }}>>(),&inv.return_type});
        }

        /* parameters ------------------------------------------------------- */
        {% for param_id in method.params -%}{%- set param = decl_from_id(param_id) -%}{%- set p_type = type_from_id(param.type_id) %}
        {
            inv.parameters.push_back({});
            lux::meta::RefParam& rp = inv.parameters.back();
            rp.name = "{{ param.name }}";
            using param_type_{{ loop.index }} = {{ p_type.id }};
            static constexpr auto qt = lux::meta::__builtin_qual_type<param_type_{{ loop.index }}>;
            static constexpr auto is_lux_obj = std::is_base_of_v<lux::meta::EntityObject, param_type_{{ loop.index }}>;
            static_assert(static_cast<lux::meta::EBaseType>(qt.base) != lux::meta::EBaseType::Unknown, "Unsupported param type for {{ method.spelling }}");

            rp.type = lux::meta::ref_type_of_v<{{ p_type.id }}>;
            if constexpr(is_lux_obj){
                fix_list.push_back({lux::cxx::type_name<lux::meta::remove_one_modifier_t<{{ p_type.id }}>>(),&rp.type});
            }
            rp.is_out = false; /* TODO out‑params */
        }
        {% endfor %}

        /* invoker ---------------------------------------------------------- */
        inv.invoker = [](void* obj_or_null, void** args, void* rst)
        {
            using ret_type = {{ method.result_type_id }};
            auto obj = static_cast<{{ rec.fq_name }}*>(obj_or_null);
            {% for param_id in method.params -%}{%- set p_type = type_from_id(decl_from_id(param_id).type_id) %}
            using param_type_{{ loop.index }} = std::remove_reference_t<{{ p_type.id }}>;
            auto arg_{{ loop.index }}_ptr = static_cast<param_type_{{ loop.index }}*>(args[{{ loop.index }}]);
            {% endfor %}

            /* 与自由函数 invoker 同因:if constexpr 只在模板内丢弃分支,
               所以把 R 绑成模板参数,否则 void 返回的方法在 clang 下编不过。
               走 type_identity tag 而非默认模板参数:MSVC 不接受后者(C3889)。 */
            [&](auto ret_tag) {
                using R = typename decltype(ret_tag)::type;
                if constexpr (std::is_void_v<R>){
                    obj->{{ method.invoke_name }}(
                        {% for _ in method.params -%}*arg_{{ loop.index }}_ptr{% if not loop.is_last %}, {% endif %}{% endfor %}
                    );
                }
                else{
                    if (rst){
                        *static_cast<R*>(rst) = obj->{{ method.invoke_name }}(
                            {% for _ in method.params -%}*arg_{{ loop.index }}_ptr{% if not loop.is_last %}, {% endif %}{% endfor %}
                        );
                    }
                    else{
                        // 同上:无结果缓冲时显式丢弃,免得被反射的 [[nodiscard]] 方法
                        // 在生成物里刷 C4834 警告。
                        (void)obj->{{ method.invoke_name }}(
                            {% for _ in method.params -%}*arg_{{ loop.index }}_ptr{% if not loop.is_last %}, {% endif %}{% endfor %}
                        );
                    }
                }
            }(std::type_identity<ret_type>{});
        };

        /* Register the method's invokable in the registry --------------- */
        size_t invokable_idx = registry.registerInvokable(inv);
        inv.container_index = invokable_idx;
    }
    {% endif %}{% endfor %}

    registry.registerClass(std::move(ret));

    /* component-type catalogue (LUX_COMPONENT only) ---------------------- */
    /* Pushed into the ECS-layer catalogue (function::ecs) rather than */
    /* the reflection registry — components are an ECS concept and stay    */
    /* out of `core::meta`. The include lives in the per-class block       */
    /* below so non-component reflected types do not drag in entt.         */
    {%- if is_component %}
    {
        lux::ecs::ComponentSchemaDescriptor _cte_{{ rec.hash }};
        _cte_{{ rec.hash }}.cpp_type.hash =
            lux::ecs::typeToken<{{ rec.fq_name }}>().hash;
        _cte_{{ rec.hash }}.cpp_type.name =
            lux::ecs::typeToken<{{ rec.fq_name }}>().name;
        _cte_{{ rec.hash }}.schema_id.name =
            lux::ecs::defaultComponentSchemaName("{{ rec.fq_name }}");
        _cte_{{ rec.hash }}.schema_version = 1u;
        _cte_{{ rec.hash }}.ref_class = &cls;
        _cte_{{ rec.hash }}.operations.has = +[](
            lux::meta::EntityRegistryBase& r,
            entt::entity e) -> bool
            { return r.all_of<{{ rec.fq_name }}>(e); };
        /* Accessors route through the shims above: empty tag types and
           move-only types get well-formed, correct behaviour instead of a
           compile error (see the shim block's comment). */
        _cte_{{ rec.hash }}.operations.get     = &lux_meta_component_get<{{ rec.fq_name }}>;
        _cte_{{ rec.hash }}.operations.emplace = &lux_meta_component_emplace<{{ rec.fq_name }}>;
        _cte_{{ rec.hash }}.operations.remove = +[](
            lux::meta::EntityRegistryBase& r,
            entt::entity e)
            { r.remove<{{ rec.fq_name }}>(e); };
        /* notify = fire on_update after a reflection field write (write contract C5): */
        /* offset pokes bypass entt's signals; the write paths (Lua proxy,     */
        /* Inspector) call this so event-driven consumers still observe them.  */
        _cte_{{ rec.hash }}.operations.notify  = &lux_meta_component_notify<{{ rec.fq_name }}>;
        /* Cross-registry (src and dst may differ) so RegistrySnapshot can    */
        /* shadow-copy. Move-only clone exists but no-ops (returns null).     */
        _cte_{{ rec.hash }}.operations.clone   = &lux_meta_component_clone<{{ rec.fq_name }}>;
        _cte_{{ rec.hash }}.operations.reserve = &lux_meta_component_reserve<{{ rec.fq_name }}>;
        _cte_{{ rec.hash }}.operations.transfer = &lux_meta_component_transfer<{{ rec.fq_name }}>;
        _cte_{{ rec.hash }}.operations.no_throw_transfer =
            std::is_empty_v<{{ rec.fq_name }}> ||
            std::is_nothrow_move_constructible_v<{{ rec.fq_name }}>;
        {%- if component_serialization == "transient" %}
        _cte_{{ rec.hash }}.serialization =
            lux::ecs::EComponentSerializationPolicy::TRANSIENT;
        {%- else if component_serialization == "persistent" %}
        _cte_{{ rec.hash }}.serialization =
            lux::ecs::EComponentSerializationPolicy::PERSISTENT;
        {%- else %}
        _cte_{{ rec.hash }}.serialization =
            lux::ecs::EComponentSerializationPolicy::COOKED;
        {%- endif %}
        _cte_{{ rec.hash }}.provider = "org.lux.builtin";
        lux::ecs::queueGeneratedComponent(std::move(_cte_{{ rec.hash }}));
    }
    {%- endif %}
}
{% endfor %}

