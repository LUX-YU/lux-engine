#version 460
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 4, binding = 7, rgba8) writeonly uniform image2D generated;
void main()
{
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    if (all(lessThan(position, imageSize(generated))))
    {
        imageStore(generated, position, vec4(0.25, 0.5, 0.75, 1.0));
    }
}
