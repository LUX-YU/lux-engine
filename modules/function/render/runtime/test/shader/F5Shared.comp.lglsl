#version 450
//! lux-shader stage=compute entry=main
layout(local_size_x=1, local_size_y=1) in;
void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(p_output)))) return;
    imageStore(p_output, pixel, vec4(p_asset.data.red, p_asset.data.green, p_asset.data.blue,
        p_asset.data.alpha) * lux_push.p_factor);
}
