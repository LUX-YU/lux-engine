{
"types": {{ types }},
"declarations": {{ declarations }},
"records": [
{% for idx in marked_record_decls %}{% set rec = decl_from_index(idx) %}
{"id": {{ json_str(rec.id) }}, "schema": {{ annotation_has(rec, "luxdata::schema") }}, "count": {{ annotation_count(rec, "luxdata::schema") }},
"arguments": {{ annotation_map_for(rec, "luxdata::schema") }} },
{% endfor %}null],
"fields": [
{% for d in declarations %}{% if d.__kind == "FieldDecl" %}
{"id": {{ json_str(d.id) }}, "count": {{ annotation_count(d, "luxdata::gpu") }}, "arguments": {{ annotation_map_for(d, "luxdata::gpu") }} },
{% endif %}{% endfor %}null]
}
