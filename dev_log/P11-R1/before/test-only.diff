+    std::shared_ptr<CommandEntry> command(std::string_view id)
+    {
+        return std::make_shared<CommandEntry>(contracts::CodeLease::builtin(),
+            CommandDescriptor{CommandId{id}, std::string{id}},
+            [](const CommandQuery&) -> CommandResult<CommandState> { return CommandState{true}; },
+            [](const CommandInvocation&) -> CommandResult<DispatchReceipt> { return DispatchReceipt{ImmediateCompletion{}}; });
+    }
+    ContributionSnapshot catalog(std::string_view id)
+    {
