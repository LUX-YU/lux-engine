        static constexpr auto qt = lux::meta::__builtin_qual_type<param_type_{{ loop.index }}>;
        static constexpr auto is_reflected_record =
            lux_meta_generated_record_v<param_type_{{ loop.index }}>;
        static constexpr auto is_reflected_value =
            lux::meta::is_reflected_value_v<
                lux::meta::remove_one_modifier_t<param_type_{{ loop.index }}>>;
        static_assert(static_cast<lux::meta::EBaseType>(qt.base) != lux::meta::EBaseType::Unknown, "Unsupported param type in {{ fn.spelling }}");
