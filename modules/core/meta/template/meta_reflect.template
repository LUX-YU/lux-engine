static void reflect_{{ rec.hash }}(lux::meta::ReflectionRegistry& registry, lux::meta::qual_type_index_fix_list& fix_list)
{
    auto ret   = std::make_unique<lux::meta::RefClass>();
    auto& cls  = *ret;

    cls.name        = "{{ rec.name }}";
    cls.full_name   = "{{ rec.fq_name }}";
    cls.is_abstract = {{ rec.is_abstract }};
    cls.hash        = {{ rec.hash }}ull;
    cls.type        = lux::meta::ref_type_of_v<{{ rec.fq_name }}>;

    fix_list.push_back({"{{ rec.fq_name }}",&cls.type});
