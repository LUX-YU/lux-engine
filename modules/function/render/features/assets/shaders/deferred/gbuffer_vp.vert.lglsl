//! lux-shader stage=vertex entry=main
#version 450
#ifdef LUX_INSTANCE_PAGED
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#endif
// =========================================================================
//  gbuffer_vp.vert — G-Buffer geometry pass, VERTEX-POOL variant
//
//  Identical interface to fr.vert but reads vertices from the bindless
//  vertex pool array (set 7) instead of vertex attribute inputs. Used
//  by every mesh draw — static and skinned alike.
// =========================================================================

// ========== SET 0: View ==========
#include "view_common.glsl"
#include "scene_global.glsl"
layout(std430) readonly buffer SceneGlobalBuffer {
    SceneGlobalGpuData scenes[];
} uSceneGlobals;
layout(std430) readonly buffer ViewBuffer {
    ViewGpuData views[];
} uViews;

// ========== Push Constants ==========
#include "view_pc_prefix.glsl"
layout(push_constant) uniform SharedPC {
    LUX_VIEW_PC_PREFIX      // uint scene_index (0); uint view_index (4)
} uPC;

// ========== SET 1: Instances ==========
#include "instance.glsl"

layout(std430) readonly buffer TransformBuf {
#ifdef LUX_INSTANCE_PAGED
    uint64_t leaf_addresses[];
#else
    InstanceTransform transforms[];
#endif
} uTransforms;

layout(std430) readonly buffer PropertyBuf {
#ifdef LUX_INSTANCE_PAGED
    uint64_t leaf_addresses[];
#else
    InstanceProperty properties[];
#endif
} uProperties;

layout(std430) readonly buffer VisibleInstanceBuf {
    GpuVisibleInstance entries[];
} uVisibleInstances;

// ========== SET 7: Bindless vertex pools ==========
#include "vertex_pool.glsl"

// ========== VS→FS varyings ==========
layout(location = 0) out vec3 vWorldPos;
layout(location = 1) out vec3 vWorldNormal;
layout(location = 2) out vec3 vViewDir;
layout(location = 3) out vec2 vUV;
layout(location = 4) out flat uint vMatIndex;
layout(location = 5) out vec3 vWorldTangent;
layout(location = 6) out vec3 vWorldBitangent;
layout(location = 7) out flat float vTransitionCoverage;
layout(location = 8) out flat uint vTransitionSeed;
layout(location = 9) out flat uint vTransitionFadeOut;
layout(location = 10) out flat vec4 vInstanceTint;

void main()
{
    uint visibleIndex = uint(gl_InstanceIndex);
    uint drawSlot = uVisibleInstances.entries[visibleIndex].instance_slot;
#ifdef LUX_INSTANCE_PAGED
    InstanceProperty prop = luxLoadInstanceProperty(
        uProperties.leaf_addresses[luxInstanceRootIndex(drawSlot)],
        drawSlot);
    InstanceTransform transform = luxLoadInstanceTransform(
        uTransforms.leaf_addresses[luxInstanceRootIndex(prop.transform_index)],
        prop.transform_index);
#else
    InstanceProperty prop = uProperties.properties[drawSlot];
    InstanceTransform transform =
        uTransforms.transforms[prop.transform_index];
#endif

    // gl_VertexIndex == draw vertexOffset + index == input_vertex_offset + local.
    // Subtract the bias so vertex_base stays the honest output base.
    uint localVertex = uint(gl_VertexIndex) - prop.input_vertex_offset;
    MeshVertex mv = luxFetchMeshVertex(prop.vertex_pool_id,
                                       prop.vertex_base,
                                       localVertex);

    ViewGpuData view_data = uViews.views[uPC.view_index];
    mat4 render_model = luxSpatialModel(
        transform,
        view_data.camera_page.xyz,
        view_data.camera_local_page_size.xyz,
        view_data.camera_local_page_size.w
    );
    mat4 model = luxSpatialModel(
        transform,
        ivec3(0),
        vec3(0.0),
        view_data.camera_local_page_size.w
    );

    vec4 worldPos  = render_model * vec4(mv.position, 1.0);
    // Cofactor (adjugate) of mat3(model) = det(M) * inverse-transpose, so the
    // normal direction matches and the normalize() below cancels the missing
    // 1/det (correct for non-uniform scale) at ~1/3 the per-vertex cost. (P-3)
    mat3 _m        = mat3(model);
    mat3 Nmat      = mat3(cross(_m[1], _m[2]), cross(_m[2], _m[0]), cross(_m[0], _m[1]));
    vec3 worldNorm = normalize(Nmat * mv.normal);
    vec3 worldTang = normalize(Nmat * mv.tangent);
    vec3 worldBitang = normalize(Nmat * mv.bitangent);

    // Gram-Schmidt TBN orthogonalization
    worldTang = normalize(worldTang - dot(worldTang, worldNorm) * worldNorm);
    worldBitang = normalize(worldBitang - dot(worldBitang, worldNorm) * worldNorm
                            - dot(worldBitang, worldTang) * worldTang);

    vWorldPos       = worldPos.xyz;
    vWorldNormal    = worldNorm;
    vWorldTangent   = worldTang;
    vWorldBitangent = worldBitang;
    vViewDir        = normalize(-worldPos.xyz);
    vUV             = mv.uv;
    vMatIndex       = packMaterialIndex(prop);
    vTransitionCoverage = luxTransitionCoverage(
        prop, uSceneGlobals.scenes[uPC.scene_index].time_sec);
    vTransitionSeed = prop.transition_seed;
    vTransitionFadeOut =
        (prop.transition_flags & LUX_TRANSITION_FADE_OUT) != 0u ? 1u : 0u;
    vInstanceTint = unpackUnorm4x8(prop.rgba8);

    gl_Position = uViews.views[uPC.view_index].proj
                * uViews.views[uPC.view_index].view
                * (render_model * vec4(mv.position, 1.0));
}
