{% for enum_idx in marked_enum_decls -%}{% set e_decl = decl_from_index(enum_idx) %}
// ──────────────────────────────────────────────────────────────────────────────
//  Reflection stub for enum {{ e_decl.name }}  (id ={{ e_decl.id }})
// ──────────────────────────────────────────────────────────────────────────────
static void reflect_{{ e_decl.hash }}(lux::meta::ReflectionRegistry& registry)
{
    auto ret  = std::make_unique<lux::meta::RefEnum>();
    auto& en  = *ret;

    en.name      = "{{ e_decl.name }}";
    en.full_name = "{{ e_decl.fq_name }}";
    en.is_scoped = {{ e_decl.is_scoped }};

    {% for enumerator in e_decl.enumerators -%}
    en.values.push_back({ "{{ enumerator.name }}", {{ enumerator.signed_value }} });
    {% endfor %}

    registry.registerEnum(std::move(ret));
}
{% endfor %}

// -----------------------------------------------------------------------------
//  Registration entry point – called from module startup
// -----------------------------------------------------------------------------
extern "C" {% if register_function_macro %}{{ register_function_macro }}{% endif %}
void {{ register_function_name }}_meta(lux::meta::ReflectionRegistry& registry, lux::meta::qual_type_index_fix_list& fix_list)
{
    {% for func_idx in marked_function_decls -%}
    reflect_func_{{ decl_from_index(func_idx).hash }}(registry, fix_list);
    {% endfor %}
    {% for record_idx in marked_record_decls -%}
    reflect_{{ decl_from_index(record_idx).hash }}(registry, fix_list);
    {% endfor %}
    {% for enum_idx in marked_enum_decls -%}
    reflect_{{ decl_from_index(enum_idx).hash }}(registry);
    {% endfor %}
}

// -----------------------------------------------------------------------------
//  Auto-registration – chains this TU into the module init queue on DLL load.
//  ReflectionRegistry::initRegistry() drains the queue; no explicit call needed.
// -----------------------------------------------------------------------------
static lux::meta::MetaModuleRegistrar
    _lux_meta_auto_register_{{ register_function_name }}(&{{ register_function_name }}_meta);

// -----------------------------------------------------------------------------
//  End of generated file
