#version 450
#ifdef PAGED_INSTANCES
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#endif

layout(local_size_x = 64) in;
struct Transform { mat4 model; };
struct Word { uint value; };
struct Property { uint mesh_index; uint material_buffer; uint material_record; uint section_index; uint render_flags; };
#ifdef PAGED_INSTANCES
struct Address { uvec2 value; };
struct PageAddresses { uvec2 transforms; uvec2 properties; uvec2 alive; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer PageLeaf { PageAddresses pages[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer TransformPage { Transform records[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer PropertyPage { Property records[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer AlivePage { Word records[]; };
layout(set = 0, binding = 0, std430) readonly buffer TransformRoots { Address roots[]; } transforms;
layout(set = 0, binding = 1, std430) readonly buffer AliveRoots { Address roots[]; } alive;
layout(set = 0, binding = 7, std430) readonly buffer PropertyRoots { Address roots[]; } properties;
#else
layout(set = 0, binding = 0, std430) readonly buffer Transforms { Transform records[]; } transforms;
layout(set = 0, binding = 1, std430) readonly buffer Alive { Word records[]; } alive;
layout(set = 0, binding = 7, std430) readonly buffer Properties { Property records[]; } properties;
#endif
struct View { mat4 world_to_clip; vec4 planes[6]; uvec4 flags; };
layout(set = 0, binding = 2, std430) readonly buffer Views { View records[]; } views;
layout(set = 0, binding = 3, std430) readonly buffer Candidates { uint words[]; } candidates;
// Records/chunk indices address the dense live-group table, not recycled CPU logical slots.
struct DrawGroup
{
    uint index_count;
    uint candidate_count;
    uint first_index;
    int vertex_offset;
    uint candidate_offset;
    uint visible_offset;
    uint visible_stride;
    uint view_count;
    vec4 center;
    vec4 half_extent;
};
layout(set = 0, binding = 4, std430) readonly buffer Groups { DrawGroup records[]; } groups;
layout(set = 0, binding = 6, std430) readonly buffer Chunks { uvec2 records[]; } chunks;
layout(set = 0, binding = 5, std430) buffer Visible { uint words[]; } visible;
layout(push_constant) uniform Parameters { uint frustum_culling; uint shadow_pass; } parameters;

shared uvec2 prefix[64];
shared uvec2 first;

void main()
{
    uint view = gl_WorkGroupID.y;
    uvec2 chunk = chunks.records[gl_WorkGroupID.x];
    DrawGroup group = groups.records[chunk.x];
    uint candidate = chunk.y + gl_LocalInvocationIndex;
    uint lane = gl_LocalInvocationIndex;
    uint instance = 0;
    uint winding = 0;
    bool included = candidate < group.candidate_count && views.records[view].flags.x != 0;
    if (included)
    {
        instance = candidates.words[group.candidate_offset + candidate];
#ifdef PAGED_INSTANCES
        uint root = instance >> 23;
        uint leaf = (instance >> 14) & 511;
        uint slot = instance & 16383;
        mat4 model = TransformPage(PageLeaf(transforms.roots[root].value).pages[leaf].transforms).records[slot].model;
        uint present = AlivePage(PageLeaf(alive.roots[root].value).pages[leaf].alive).records[slot].value;
        uint flags = PropertyPage(PageLeaf(properties.roots[root].value).pages[leaf].properties).records[slot].render_flags;
#else
        mat4 model = transforms.records[instance].model;
        uint present = alive.records[instance].value;
        uint flags = properties.records[instance].render_flags;
#endif
        float determinant = dot(model[0].xyz, cross(model[1].xyz, model[2].xyz));
        winding = determinant < 0 ? 1 : 0;
        uint required = parameters.shadow_pass != 0 ? 3u : 1u;
        included = present != 0 && determinant != 0 && (flags & required) == required;
        if (included && parameters.frustum_culling != 0 && group.center.w != 0)
        {
            // Legacy frustumCull half-space test. The support radius uses the transformed AABB axes,
            // rather than a uniform-scale sphere assumption: mirrors, shear and nonuniform scales stay conservative.
            vec3 center = (model * vec4(group.center.xyz, 1)).xyz;
            for (uint p = 0; p < 6; ++p)
            {
                vec4 plane = views.records[view].planes[p];
                vec3 local_normal = transpose(mat3(model)) * plane.xyz;
                float radius = dot(abs(local_normal), group.half_extent.xyz);
                if (dot(plane.xyz, center) + plane.w < -radius)
                    included = false;
            }
        }
    }
    prefix[lane] = uvec2(included && winding == 0 ? 1 : 0, included && winding == 1 ? 1 : 0);
    barrier();
    // One contiguous reservation per workgroup, as in Legacy's shadow cull. All lanes reach every barrier.
    for (uint stride = 1; stride < 64; stride <<= 1)
    {
        uvec2 before = lane >= stride ? prefix[lane - stride] : uvec2(0);
        barrier();
        prefix[lane] += before;
        barrier();
    }
    uint stride = group.visible_stride;
    uint offset = group.visible_offset + view * 2 * stride;
    if (lane == 63)
    {
        first.x = atomicAdd(visible.words[offset + 1], prefix[lane].x);
        first.y = atomicAdd(visible.words[offset + stride + 1], prefix[lane].y);
    }
    barrier();
    if (included)
        visible.words[offset + winding * stride + 5 + first[winding] + prefix[lane][winding] - 1] = instance;
}
