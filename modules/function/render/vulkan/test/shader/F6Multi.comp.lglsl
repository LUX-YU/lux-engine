#version 450
//! lux-shader stage=compute entry=main
layout(local_size_x=1) in;
void main()
{
    uint c = gl_GlobalInvocationID.x;
    p_output.data[c] = p_main_light.data[0].color[c] * p_material.data[0].tint[c]
        + p_preview_light.data[0].color[c] + p_main_light.data[0].position.intensity
        + p_material.data[0].roughness;
}
