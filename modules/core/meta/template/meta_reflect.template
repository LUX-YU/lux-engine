    {%- set is_object = annotation_has(rec, "object") -%}
    {%- set is_reflected_field = annotation_has(field, "luxref::property::member") -%}
    {%- set skip_field = annotation_has(field, "luxref::property::skip") -%}
    {%- set skip_runtime = annotation_get_for_or(field, "luxtype::member", "skip_runtime", false) -%}
