        && !std::is_abstract_v<{{ rec.fq_name }}>) {
        cls.construct = constructor_{{ rec.hash }};
        cls.construct_symbol = "constructor_{{ rec.hash }}";
    }
    if constexpr (std::is_destructible_v<{{ rec.fq_name }}>) {
        cls.destruct = destructor_{{ rec.hash }};
        cls.destruct_symbol = "destructor_{{ rec.hash }}";
