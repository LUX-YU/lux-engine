//! lux-shader stage=fragment entry=main
#version 450

// Depth-only fragment shader
// Used for depth prepass, outputs no color
// Only writes depth values

// Consume all VS outputs to suppress validation performance warnings
// Must match fr.vert output layout exactly:
//   loc 0: vec3 vWorldPos
//   loc 1: vec3 vWorldNormal
//   loc 2: vec3 vViewDir
//   loc 3: vec2 vUV
//   loc 4: flat uint vMatIndex
layout(location = 0) in vec3 vWorldPos;
layout(location = 1) in vec3 vWorldNormal;
layout(location = 2) in vec3 vViewDir;
layout(location = 3) in vec2 vUV;
layout(location = 4) in flat uint vMatIndex;
layout(location = 7) in flat float vTransitionCoverage;
layout(location = 8) in flat uint vTransitionSeed;
layout(location = 9) in flat uint vTransitionFadeOut;

#include "transition_dither.glsl"

void main() 
{
    luxApplyDirectedTransitionCoverage(
        vTransitionCoverage, vTransitionSeed, vTransitionFadeOut != 0u);
    // Depth values are automatically written during rasterization
    // No output needed
}
