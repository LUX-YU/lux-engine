        auto arg_{{ loop.index }}_ptr = static_cast<param_type_{{ loop.index }}*>(args[{{ loop.index }}]);
        {% endfor %}

        /* The inner lambda is load-bearing, not style: `if constexpr` only
           discards a branch inside a TEMPLATE. Written directly in this
           (non-template) lambda, the void case still had to compile
           `*static_cast<void*>(rst) = f(...)` — ill-formed. MSVC accepts it,
           clang rejects it, so the whole reflection sidecar built on the host
           and failed the moment it was cross-compiled. Making R a template
           parameter means the dead branch is never instantiated on either.

           R arrives via a type_identity tag rather than `[]<class R = ret_type>()`:
           MSVC rejects calling such a lambda with no arguments (C3889 — it will
           not take R from the default). Tag dispatch deduces R instead, which
           both compilers accept. */
