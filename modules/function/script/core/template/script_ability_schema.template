int main(int argc, char** argv)
{
    if (argc != 2 || argv[1] == nullptr)
        return 2;
    std::ofstream output(argv[1], std::ios::binary | std::ios::trunc);
    if (!output)
        return 3;
    output << "{\"schema\":\"lux-script-ability\",\"version\":2,\"abilities\":[";
    for (std::size_t index{}; index < AbilityDescriptions.size(); ++index)
    {
        if (index != 0U)
            output.put(',');
        writeDescription(output, *AbilityDescriptions[index]);
    }
    output << "]}\n";
    return output ? 0 : 4;
}
