{
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": false
    },
    "C_Cpp.clang_format_style": "file",
    "cmake.generator": "Ninja",
    "cmake.buildDirectory": "${workspaceFolder}/../build/${buildType}/lux-engine-framework",
    "cmake.configureArgs": [
        "-DCMAKE_TOOLCHAIN_FILE=${env:LUX_CMAKE_TOOLCHAIN}",
        "-DCMAKE_PREFIX_PATH=${env:LUX_CMAKE_PREFIX_PATH}",
        "-DLUX_BUILD_PROFILE=EDITOR",
        "-DLUX_BUILD_PACKED_RENDER_CONTENT=ON",
        "-DBUILD_TESTING=ON"
    ],
    "cmake.installPrefix": "${env:LUX_FRAMEWORK_SDK}",
    "terminal.integrated.cwd": "${workspaceFolder}"
}
