{
  "diagnostics": [
{% set emitted = false %}{% for rec_index in marked_record_decls %}{% set rec = decl_from_index(rec_index) %}{% set receiver = annotation_get_for_or(rec, "luxability::contract", "receiver", "") %}{% if receiver == "none" %}{% set ability_methods = rec.static_method_decls %}{% else %}{% set ability_methods = rec.method_decls %}{% endif %}{% set contract_id = annotation_get_for_or(rec, "luxability::contract", "id", "") %}{% if contract_id == "" or annotation_count(rec, "version") != 1 or (receiver != "none" and receiver != "provider_instance") %}{% if emitted %},{% endif %}
    {"severity":"error","declaration":{{ json_str(rec.fq_name) }},"message":"Ability requires explicit id, version and receiver=none|provider_instance"}{% set emitted = true %}{% endif %}{% for method_id in ability_methods %}{% set method = decl_from_id(method_id) %}{% if annotation_has(method, "luxability::method") %}{% set id = annotation_get_for_or(method, "luxability::method", "id", "") %}{% set kind = annotation_get_for_or(method, "luxability::method", "kind", "") %}{% set result_lifetime = annotation_get_for_or(method, "luxability::method", "result_lifetime", "") %}{% set invalid_result_lifetime = method.result_type_id != "void" and result_lifetime != "owned_value" and result_lifetime != "stable_id" and result_lifetime != "borrowed_step" and result_lifetime != "awaitable" %}{% if id == "" or (kind != "query" and kind != "command" and kind != "async_operation") or method.is_variadic or (receiver == "none" and not method.is_static) or (receiver == "provider_instance" and method.is_static) or (kind == "command" and method.result_type_id != "void") or invalid_result_lifetime or (kind == "async_operation" and result_lifetime != "awaitable") or (kind != "async_operation" and result_lifetime == "awaitable") %}{% if emitted %},{% endif %}
    {"severity":"error","declaration":{{ json_str(method.fq_name) }},"message":"invalid Ability method id/kind/receiver/noexcept/result contract"}{% set emitted = true %}{% endif %}{% set result_spelling = method.result_type_id %}{% set result_has_ref = length(replace(result_spelling, "&", "")) != length(result_spelling) %}{% set result_has_rvalue = length(replace(result_spelling, "&&", "")) != length(result_spelling) %}{% set result_has_const = length(replace(result_spelling, "const", "")) != length(result_spelling) %}{% set result_has_volatile = length(replace(result_spelling, "volatile", "")) != length(result_spelling) %}{% if result_has_rvalue or result_has_volatile or (result_has_ref and not result_has_const) %}{% if emitted %},{% endif %}
    {"severity":"error","declaration":{{ json_str(method.fq_name) }},"message":"unsupported mutable/rvalue/volatile Script Ability result"}{% set emitted = true %}{% endif %}{% for param_id in method.params %}{% set param = decl_from_id(param_id) %}{% set type = type_from_id(param.type_id) %}{% set type_spelling = type.id %}{% set has_ref = length(replace(type_spelling, "&", "")) != length(type_spelling) %}{% set has_rvalue = length(replace(type_spelling, "&&", "")) != length(type_spelling) %}{% set has_const = length(replace(type_spelling, "const", "")) != length(type_spelling) %}{% set has_volatile = length(replace(type_spelling, "volatile", "")) != length(type_spelling) %}{% if has_rvalue or has_volatile or (has_ref and not has_const) %}{% if emitted %},{% endif %}
    {"severity":"error","declaration":{{ json_str(param.name) }},"message":"unsupported mutable/rvalue/volatile Script Ability parameter"}{% set emitted = true %}{% endif %}{% set lifetime = annotation_get_for_or(param, "luxability::param", "lifetime", "") %}{% if lifetime != "owned_value" and lifetime != "stable_id" and lifetime != "borrowed_step" %}{% if emitted %},{% endif %}
    {"severity":"error","declaration":{{ json_str(param.name) }},"message":"Ability parameter requires owned_value|stable_id|borrowed_step lifetime"}{% set emitted = true %}{% endif %}{% if kind == "async_operation" and lifetime == "borrowed_step" %}{% if emitted %},{% endif %}
    {"severity":"error","declaration":{{ json_str(param.name) }},"message":"BORROWED_STEP cannot cross an async Ability boundary"}{% set emitted = true %}{% endif %}{% endfor %}{% endif %}{% endfor %}{% for left_id in ability_methods %}{% set left = decl_from_id(left_id) %}{% if annotation_has(left, "luxability::method") %}{% set stable_id = annotation_get_for_or(left, "luxability::method", "id", "") %}{% for right_id in ability_methods %}{% set right = decl_from_id(right_id) %}{% if left_id != right_id and annotation_has(right, "luxability::method") and stable_id != "" and stable_id == annotation_get_for_or(right, "luxability::method", "id", "") %}{% if emitted %},{% endif %}
    {"severity":"error","declaration":{{ json_str(left.fq_name) }},"message":"duplicate Script Ability MethodId"}{% set emitted = true %}{% endif %}{% endfor %}{% endif %}{% endfor %}{% endfor %}
  ]
}
