// ──────────────────────────────────────────────────────────────────────────────
//  Reflection stub for free function {{ fn.spelling }}  (id ={{ fn.id }})
// ──────────────────────────────────────────────────────────────────────────────
static void reflect_func_{{ fn.hash }}(lux::meta::ReflectionRegistry& registry, lux::meta::qual_type_index_fix_list& fix_list)
{
    auto ret  = std::make_unique<lux::meta::RefFunction>();
    auto& f   = *ret;
    auto& inv = f.invokable;

    /* basic info ----------------------------------------------------------- */
    inv.name        = "{{ fn.spelling }}";
    inv.full_name   = "{{ fn.fq_name }}";
    inv.is_variadic = {{ fn.is_variadic }};
    inv.type_signature = "{{ fn.type_id }}";

    /* return type ---------------------------------------------------------- */
    using ret_type  = {{ fn.result_type_id }};
    static constexpr auto ret_qt = lux::meta::__builtin_qual_type<ret_type>;
    static constexpr auto is_lux_obj = std::is_base_of_v<lux::meta::EntityObject, ret_type>;
    static_assert(static_cast<lux::meta::EBaseType>(ret_qt.base) != lux::meta::EBaseType::Unknown, "Unsupported return type in {{ fn.spelling }}");

    inv.return_type = lux::meta::ref_type_of_v<ret_type>;

    if constexpr(is_lux_obj){
        fix_list.push_back({lux::cxx::type_name<lux::meta::remove_one_modifier_t<{{ fn.result_type_id }}>>(),&inv.return_type});
    }

    /* parameters ----------------------------------------------------------- */
    {% for param_id in fn.params %}
    {%- set p = decl_from_id(param_id) -%}{%- set pty = type_from_id(p.type_id) %}
    {
        inv.parameters.push_back({});
        lux::meta::RefParam& rp = inv.parameters.back();
        rp.name = "{{ p.name }}";
        using param_type_{{ loop.index }} = {{ pty.id }};

        static constexpr auto qt = lux::meta::__builtin_qual_type<param_type_{{ loop.index }}>;
        static constexpr auto is_lux_obj = std::is_base_of_v<lux::meta::EntityObject, param_type_{{ loop.index }}>;
        static_assert(static_cast<lux::meta::EBaseType>(qt.base) != lux::meta::EBaseType::Unknown, "Unsupported param type in {{ fn.spelling }}");
        rp.type = lux::meta::ref_type_of_v<{{pty.id}}>;
        if constexpr(is_lux_obj){
            fix_list.push_back({lux::cxx::type_name<lux::meta::remove_one_modifier_t<{{ pty.id }}>>(),&rp.type});
        }
        rp.is_out = false;  /* TODO: mark out‑params */
    }
    {% endfor %}

    /* invoker -------------------------------------------------------------- */
    inv.invoker = [](void*, void** args, void* rst)
    {
        using ret_type = {{ fn.result_type_id }};
        {% for param_id in fn.params -%}{%- set p = decl_from_id(param_id) -%}{%- set pty = type_from_id(p.type_id) %}
        using param_type_{{ loop.index }} = std::remove_reference_t<{{ pty.id }}>;
        auto arg_{{ loop.index }}_ptr = static_cast<param_type_{{ loop.index }}*>(args[{{ loop.index }}]);
        {% endfor %}

        /* The inner lambda is load-bearing, not style: `if constexpr` only
           discards a branch inside a TEMPLATE. Written directly in this
           (non-template) lambda, the void case still had to compile
           `*static_cast<void*>(rst) = f(...)` — ill-formed. MSVC accepts it,
           clang rejects it, so the whole reflection sidecar built on the host
           and failed the moment it was cross-compiled. Making R a template
           parameter means the dead branch is never instantiated on either.

           R arrives via a type_identity tag rather than `[]<class R = ret_type>()`:
           MSVC rejects calling such a lambda with no arguments (C3889 — it will
           not take R from the default). Tag dispatch deduces R instead, which
           both compilers accept. */
        [&](auto ret_tag) {
            using R = typename decltype(ret_tag)::type;
            if constexpr (std::is_void_v<R>){
                {{ fn.invoke_name }}(
                    {% for _ in fn.params -%}*arg_{{ loop.index }}_ptr{% if not loop.is_last %}, {% endif %}{% endfor %}
                );
            }
            else{
                if(rst){
                    *static_cast<R*>(rst) = {{ fn.invoke_name }}(
                        {% for _ in fn.params -%}*arg_{{ loop.index }}_ptr{% if not loop.is_last %}, {% endif %}{% endfor %}
                    );
                }
                else{
                    // 调用方没给结果缓冲 —— 返回值确实无处可去。显式丢弃,否则被反射的
                    // [[nodiscard]] 函数会在生成物里刷 C4834 警告。
                    (void){{ fn.invoke_name }}(
                        {% for _ in fn.params -%}*arg_{{ loop.index }}_ptr{% if not loop.is_last %}, {% endif %}{% endfor %}
                    );
                }
            }
        }(std::type_identity<ret_type>{});
    };

    /* Register the invokable first -------------------------------------- */
    size_t invokable_idx = registry.registerInvokable(inv);
    inv.container_index  = invokable_idx;

    /* Then register the function with reference to the invokable -------- */
    lux::meta::RefFunctionKey key{
        "{{ fn.invoke_name }}",
        std::vector<uint64_t>{
            {% for param_id in fn.params %}{%- set p = decl_from_id(param_id) -%}{%- set pty = type_from_id(p.type_id) -%}
            lux::cxx::type_hash<{{ pty.id }}>(){% if not loop.is_last %}, 
            {% endif %}{% endfor %}
        }
    };
    f.container_index = invokable_idx;
    registry.registerFunction(key, std::move(ret));
}
