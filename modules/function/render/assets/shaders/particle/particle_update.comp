#version 450
// =============================================================================
// particle_update.comp — GPU particle simulation compute shader
//
// Each invocation handles one particle.
//   • Alive: advance position by velocity*dt, decay lifetime.
//   • Dead:  skip (lifetime stays negative).
//
// Set 0: Particle SSBO (read+write)
// Push constant: delta_time
// =============================================================================

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct ParticleGpu {
    vec3  position;
    float lifetime;
    vec3  velocity;
    float max_lifetime;
    vec4  color;
    float size;
    uint  flags;
    vec2  _pad;
};

layout(set = 0, binding = 0, std430) buffer ParticleSSBO {
    ParticleGpu particles[];
} uParticles;

layout(push_constant) uniform PushConstants {
    float delta_time;    ///< Frame dt in seconds
    float gravity;       ///< Downward acceleration (positive = down)
    uint  max_particles; ///< Size of the particle array
    float _pad;
} pc;

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.max_particles) return;

    ParticleGpu p = uParticles.particles[idx];

    // Skip dead particles.
    if (p.lifetime < 0.0 || (p.flags & 1u) == 0u) return;

    // Euler integration: apply gravity and advance position.
    p.velocity.y  -= pc.gravity * pc.delta_time;
    p.position    += p.velocity * pc.delta_time;
    p.lifetime    -= pc.delta_time;

    // Mark dead when lifetime expires.
    if (p.lifetime < 0.0) {
        p.lifetime = -1.0;
        p.flags   &= ~1u;   // clear alive bit
    }

    uParticles.particles[idx] = p;
}
