#version 450

layout(local_size_x = 64) in;

struct GpuCullCluster
{
    ivec4 page_visible;
    vec4 local_radius;
};

layout(set = 0, binding = 0, std430) readonly buffer ClusterBuffer
{
    GpuCullCluster clusters[];
} uClusters;

layout(set = 0, binding = 1, std430) writeonly buffer VisibilityBuffer
{
    uint visible[];
} uVisibility;

layout(push_constant) uniform ClusterCullPush
{
    uint scene_index;
    uint view_index;
    uint cluster_count;
    uint frustum_enabled;
    ivec4 origin_page;
    vec4 origin_local_page_size;
    mat4 view_proj;
} pc;

bool sphereInsideClip(vec3 center, float radius)
{
    vec4 clip = pc.view_proj * vec4(center, 1.0);
    vec3 row_x = vec3(
        pc.view_proj[0][0], pc.view_proj[1][0], pc.view_proj[2][0]);
    vec3 row_y = vec3(
        pc.view_proj[0][1], pc.view_proj[1][1], pc.view_proj[2][1]);
    vec3 row_z = vec3(
        pc.view_proj[0][2], pc.view_proj[1][2], pc.view_proj[2][2]);
    float radius_x = radius * length(row_x);
    float radius_y = radius * length(row_y);
    float radius_z = radius * length(row_z);
    if (clip.x < -clip.w - radius_x || clip.x > clip.w + radius_x)
        return false;
    if (clip.y < -clip.w - radius_y || clip.y > clip.w + radius_y)
        return false;
    // Vulkan clip depth is [0,w].
    if (clip.z < -radius_z || clip.z > clip.w + radius_z)
        return false;
    return clip.w + max(max(radius_x, radius_y), radius_z) > 0.0;
}

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.cluster_count)
        return;
    GpuCullCluster cluster = uClusters.clusters[index];
    if (cluster.page_visible.w == 0 || cluster.local_radius.w < 0.0)
    {
        uVisibility.visible[index] = 0u;
        return;
    }
    if (pc.frustum_enabled == 0u)
    {
        uVisibility.visible[index] = 1u;
        return;
    }
    vec3 center = vec3(cluster.page_visible.xyz - pc.origin_page.xyz) *
            pc.origin_local_page_size.w +
        cluster.local_radius.xyz - pc.origin_local_page_size.xyz;
    uVisibility.visible[index] = sphereInsideClip(
        center, cluster.local_radius.w) ? 1u : 0u;
}
