//! lux-shader stage=vertex entry=main
#version 450

// =============================================================================
// Canvas2D image vertex shader (v2, GPU-driven — vertex pulling).
//
// NO vertex inputs. Each instance is one image: gl_InstanceIndex walks the
// arena's ORDER buffer (slot indices in ascending sort-key order — the draw
// sequence IS the painter order), the slot indexes the instance records, and
// gl_VertexIndex (0..5) synthesizes a unit ±0.5 quad corner that the image's
// baked 2D affine places in world space. The scene camera comes from the SAME
// per-view ViewGpuData path as 3D (set 0, binding 1).
//
// Image2DInstanceData (std430, 56 B — keep Canvas2DOperation.hpp in sync):
//   float m[6]     column-major 2D affine: c0.x c0.y c1.x c1.y tx ty
//   int page[2]    object page relative to the RenderScene origin page
//   float uv[4]    atlas rect: u0, v0, w, h
//   uint  tint     PREMULTIPLIED RGBA8, R[7:0]..A[31:24]
//   uint  tex      bindless set-2 index, or 0xFFFFFFFF = tint-only
// =============================================================================

struct Image2DInstance {
    float m0x; float m0y;   // world col0.xy
    float m1x; float m1y;   // world col1.xy
    float tx;  float ty;    // translation
    int page_x; int page_y;
    float u0;  float v0;    // uv origin
    float uw;  float vh;    // uv extent
    uint  tint;
    uint  tex;
};

layout(std430) readonly buffer ImageBuf {
    Image2DInstance images[];
} uImages;

layout(std430) readonly buffer OrderBuf {
    uint order[];
} uOrder;

#include "view_common.glsl"
layout(std430) readonly buffer ViewBuffer {
    ViewGpuData views[];
} uViews;

#include "view_pc_prefix.glsl"
layout(push_constant) uniform PC {
    LUX_VIEW_PC_PREFIX      // uint scene_index (0); uint view_index (4)
} uPC;

layout(location = 0) out vec2 vUV;
layout(location = 1) out vec4 vColor;
layout(location = 2) flat out uint vTexBindless;
/// The image's atlas rect (u0, v0, uw, vh) — the FS needs its extent to bound
/// the mip level it samples, so a minified image can never read a mip texel
/// that averages across the neighbouring atlas frame.
layout(location = 3) flat out vec4 vRect;

// Two CCW triangles over a unit quad centred at the origin.
const vec2 kCorners[6] = vec2[6](
    vec2(-0.5, -0.5), vec2(0.5, -0.5), vec2(0.5, 0.5),
    vec2(-0.5, -0.5), vec2(0.5,  0.5), vec2(-0.5, 0.5)
);

void main()
{
    const uint slot = uOrder.order[gl_InstanceIndex];
    const Image2DInstance s = uImages.images[slot];
    const vec2 c = kCorners[gl_VertexIndex];

    const vec2 world_local = vec2(
        s.m0x * c.x + s.m1x * c.y + s.tx,
        s.m0y * c.x + s.m1y * c.y + s.ty);
    const ViewGpuData view_data = uViews.views[uPC.view_index];
    const ivec2 page_delta = ivec2(s.page_x, s.page_y) -
        view_data.camera_page.xy;
    const vec2 view_relative = vec2(page_delta) *
        view_data.camera_local_page_size.w + world_local -
        view_data.camera_local_page_size.xy;
    gl_Position = uViews.views[uPC.view_index].proj
                * uViews.views[uPC.view_index].view
                * vec4(view_relative, 0.0, 1.0);

    // uv: +x → u grows; +y (up) → v shrinks (top of the image = top of the rect).
    vUV          = vec2(s.u0 + (c.x + 0.5) * s.uw,
                        s.v0 + (0.5 - c.y) * s.vh);
    vTexBindless = s.tex;
    vRect        = vec4(s.u0, s.v0, s.uw, s.vh);

    const float r = float((s.tint >>  0u) & 0xFFu) / 255.0;
    const float g = float((s.tint >>  8u) & 0xFFu) / 255.0;
    const float b = float((s.tint >> 16u) & 0xFFu) / 255.0;
    const float a = float((s.tint >> 24u) & 0xFFu) / 255.0;
    vColor = vec4(r, g, b, a);   // already premultiplied (pipeline blends ONE / 1-SRC_ALPHA)
}
