        inv.name        = "{{ method.spelling }}";
        inv.full_name   = "{{ method.fq_name }}";
        inv.is_variadic = {{ method.is_variadic }};
        inv.type_signature   = "{{ method.type_id }}";

        /* return ----------------------------------------------------------- */
        using ret_type = {{ method.result_type_id }};
        static constexpr auto qt_ret = lux::meta::__builtin_qual_type<ret_type>;
        static constexpr auto is_reflected_record =
            lux_meta_generated_record_v<ret_type>;
