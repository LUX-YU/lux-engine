#version 450
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require
//! lux-shader stage=fragment entry=main
//! lux-pass-declarations
#include "Parameters.shared.lglslh"
layout(location=0) out vec4 output_color;
void main()
{
    vec4 sampled = textureLod(textures[nonuniformEXT(uint(parameters.control.x))], gl_FragCoord.xy / vec2(16), 0);
    output_color = sampled * sharedColor() * parameters.view * parameters.gain + parameters.bias;
}
