// Single source of truth for portable Lux Script primitive semantics.
// Consumers define LUX_SCRIPT_BUILTIN(tag, cpp_type, canonical_name, abi_kind)
// before including this file. Tooling may parse the four comma-separated fields.
LUX_SCRIPT_BUILTIN(BOOL, bool, "lux.bool", LUX_SCRIPT_VK_BOOL)
LUX_SCRIPT_BUILTIN(I32, std::int32_t, "lux.i32", LUX_SCRIPT_VK_INT32)
LUX_SCRIPT_BUILTIN(U32, std::uint32_t, "lux.u32", LUX_SCRIPT_VK_UINT32)
LUX_SCRIPT_BUILTIN(I64, std::int64_t, "lux.i64", LUX_SCRIPT_VK_INT64)
LUX_SCRIPT_BUILTIN(U64, std::uint64_t, "lux.u64", LUX_SCRIPT_VK_UINT64)
LUX_SCRIPT_BUILTIN(F32, float, "lux.f32", LUX_SCRIPT_VK_FLOAT)
LUX_SCRIPT_BUILTIN(F64, double, "lux.f64", LUX_SCRIPT_VK_DOUBLE)
