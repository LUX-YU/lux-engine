#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, r32f) uniform writeonly image2D generated;
void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(generated);
    if (any(greaterThanEqual(p, size)))
    {
        return;
    }
    imageStore(generated, p, vec4(all(equal(p, size - 1)) ? 0.9 : 0.2));
}
