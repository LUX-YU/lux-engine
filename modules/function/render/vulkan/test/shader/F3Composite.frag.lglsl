#version 450
//! lux-shader stage=fragment entry=main
layout(location=0) out vec4 color;
void main()
{
    ivec2 pixel = ivec2(gl_FragCoord.xy);
    vec4 first = texelFetch(sampler2D(p_inputs[0], p_nearest), pixel, 0);
    vec4 second = texelFetch(sampler2D(p_inputs[1], p_nearest), pixel, 0);
#ifdef F3_ADDITIVE
    color = first + second * lux_push.p_weight;
#else
    color = mix(first, second, lux_push.p_weight);
#endif
}
